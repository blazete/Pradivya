<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS: this build lives in D:\Pradivya\ai under the pradivya.com site. <clear/> drops the parent site's
     SPA rule (which rewrites to "/", the main site); unknown /ai/* paths go to this app's index.html. -->
<configuration>
  <system.webServer>
    <!-- WUSADMIN's IIS has no .webp type (IIS answers 404 for unknown types); remove-then-add is safe either way -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <rewrite>
      <rules>
        <clear />
        <rule name="AI React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/ai/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
